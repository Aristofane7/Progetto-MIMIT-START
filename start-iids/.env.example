# START IIDS — environment template. Copy to .env and fill in real values.
# Never commit a real .env file.

# --- Relational analytical core (PostgreSQL-compatible; Azure SQL alternative in prod) ---
IIDS_DB_HOST=localhost
IIDS_DB_PORT=5432
IIDS_DB_NAME=iids
IIDS_DB_USER=iids_app
IIDS_DB_PASSWORD=

# --- Object storage / Data Lake ---
IIDS_LAKE_ACCOUNT_URL=
IIDS_LAKE_CONTAINER=iids-raw

# --- Feature flags (see config/features.yaml for the authoritative source) ---
ENABLE_ACTUATION=false

# --- Timezone ---
IIDS_STORAGE_TZ=UTC
IIDS_DISPLAY_TZ=Europe/Rome
