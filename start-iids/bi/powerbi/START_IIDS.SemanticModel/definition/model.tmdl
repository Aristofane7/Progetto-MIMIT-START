ref table FactShadowState
ref table DimPlant
ref table DimLine
ref table DimProcess
ref table DimProduct
ref table DimCluster
ref table DimDate

ref expression DataSourceMode
ref expression LocalCsvFolder
ref expression SqlServer
ref expression SqlDatabase
